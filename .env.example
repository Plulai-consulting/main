# Copy to .env.local and fill in
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret: server only
FAL_KEY=your-fal-key                              # secret: server only
# AI writing (prompt booster + marketing strategist): fill in ONE of these
OPENROUTER_API_KEY=your-openrouter-key
ANTHROPIC_API_KEY=your-anthropic-key
LLM_PROVIDER=openrouter                           # switch to: anthropic
CRON_SECRET=make-up-a-long-random-string          # protects /api/sweep (needed once deployed)

# Anti-abuse and housekeeping (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key   # also enable Captcha protection in Supabase Auth settings
RETENTION_DAYS=90                                                   # results older than this are deleted by /api/sweep
